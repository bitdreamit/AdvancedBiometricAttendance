  "server": {
    "_comment": "Replace url and api_key with your server details. Leave url blank to disable sync.",
    "url": "",
    "api_key": "",
    "sync_enabled": false,
    "verify_ssl": true,
    "timeout": 30
  },
  "security": {
    "encryption_enabled": false,
    "integrity_check": false
  },
  "application": {
    "auto_start": false,
    "minimize_to_tray": true,
